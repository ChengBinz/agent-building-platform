# ==========================================
# AI Agent Platform - Environment Variables
# ==========================================

# --- App ---
APP_NAME=AI Agent Platform
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars

# --- PostgreSQL ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_platform

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Redis (optional) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Default Models ---
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# --- Ports ---
NGINX_PORT=80
PG_EXPOSE_PORT=5432
QDRANT_EXPOSE_PORT=6333
REDIS_EXPOSE_PORT=6379
